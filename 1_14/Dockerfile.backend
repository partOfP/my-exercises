FROM golang:1.27

WORKDIR /usr/src/app

# pre-copy/cache go.mod for pre-downloading dependencies and only redownloading them in subsequent builds if they change
COPY 1_13/go.mod 1_13/go.sum ./

RUN go mod download

COPY 1_13 .

EXPOSE 8080

ENV PORT=8080
ENV REQUEST_ORIGIN="http://localhost:5001"

RUN go build 

CMD ["./server"]
